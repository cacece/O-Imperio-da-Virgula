theme_override_font_sizes/font_size = 18
text = "2. REGRAS DE ALTERAÇÃO"

[node name="TextoPasso2" type="RichTextLabel" parent="PainelExplicacao/MarginExplicacao/VBoxExplicacao/Passo2" unique_id=987654337]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 15
bbcode_enabled = true
text = "• Pontuações são totalmente livres.\n• Não é permitido alterar palavras inteiras, mas você pode apagar 1 letra por vez para trocar acentos (ex: [i]e[/i] por [i]é[/i])."
fit_content = true

